rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check role
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    // Helper function to check if user is active
    function isActive() {
      return isAuthenticated() && getUserData().active == true;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own data
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Managers and admins can read all users
      allow read: if hasRole('manager') || hasRole('admin');
      
      // Admins can create any user profile. Users may only create *their own* profile as an employee.
      // This prevents a newly-created Auth user from self-assigning elevated roles like admin/manager.
      allow create: if hasRole('admin') || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.active == true &&
        request.resource.data.role == 'employee'
      );
      
      // Admins can update any user field. Non-admin users may update only
      // their OWN profile, and only self-service fields (timezone + the
      // `updatedAt` bookkeeping timestamp). Protected fields like role,
      // workModel, workModelId, active, and uid remain admin-only, so an
      // employee cannot escalate their own role or change their work model.
      function isSelfServiceProfileUpdate() {
        return isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['timezone', 'updatedAt']);
      }

      allow update: if hasRole('admin') || isSelfServiceProfileUpdate();
      allow delete: if hasRole('admin');
    }
    
    // Time entries collection
    match /timeEntries/{entryId} {
      // Users can get individual entries (even non-existent ones) or list their own entries
      allow get: if isAuthenticated() && 
                    (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Managers can read entries from all users
      allow read: if hasRole('manager') || hasRole('admin');
      
      // Users can create/update their own entries
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       isActive();
      
      allow update: if isAuthenticated() && 
                       (request.auth.uid == resource.data.userId || hasRole('admin')) &&
                       isActive() &&
                       // userId field is immutable for non-admins (cannot reassign entry to another user)
                       (hasRole('admin') || !('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId);
      
      // Only admins can delete entries
      allow delete: if hasRole('admin');
    }
    
    // Correction Requests collection
    match /correctionRequests/{requestId} {
      // Employees can create their own requests
      allow create: if isAuthenticated() && 
                       request.resource.data.employee_id == request.auth.uid &&
                       isActive();
      
      // Employees can read their own requests
      allow list: if isAuthenticated() && 
                     resource.data.employee_id == request.auth.uid;
      allow get: if isAuthenticated() && 
                    (resource == null || resource.data.employee_id == request.auth.uid);
      
      // Managers and admins can read all requests
      allow read: if hasRole('manager') || hasRole('admin');
      
      // Only admins can update requests (status changes)
      allow update: if hasRole('admin');
    }
    
    // System Settings collection
    match /systemSettings/{document} {
      // Admins can read and write all system settings
      allow read, write: if hasRole('admin');
      
      // All authenticated users can read payroll settings to respect lock dates
      allow read: if isAuthenticated() && document == 'payroll';
    }

    // workModels collection — per-work-model overtime configuration
    // (On-site, Remote, custom). Read by any authenticated user: employee-side
    // components (e.g. the ClockPunch Daily Report trigger) need the
    // authoritative workModelId → name lookup. This grants employees net-new
    // read access to policy-level configuration (model names, OT/DT thresholds
    // and multipliers, noOvertime) — accepted because the collection holds no
    // per-employee data, no pay rates, and no PII. Write stays admin-only
    // since it affects pay math.
    match /workModels/{modelId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }

    // auditLogs collection — immutable append-only audit trail
    // Created by Phase 1 admin correction hardening
    match /auditLogs/{logId} {
      // Admins and managers can read audit logs
      allow read: if hasRole('admin') || hasRole('manager');
      
      // Create: admins/managers (any correction) OR employees performing a SELF
      // direct edit (≤24h Quick Edit path).
      //
      // ADMIN/MANAGER PATH (policy change 2026-08): admins and managers may
      // create audit logs with an EMPTY reason — the immutable audit row is
      // still written, but the mandatory-note requirement is lifted for
      // admin/manager-initiated edits.
      //
      // EMPLOYEE PATH: tightly scoped so a user can only audit their OWN
      // self-correction:
      //   - actorRole == 'employee'
      //   - actorUid == the authenticated user
      //   - action == 'time_correction' on 'timeEntries' only
      //   - targetId is their own entry doc (uid_YYYY-MM-DD)
      //   - reason is a non-empty string (mandatory for employees)
      // This keeps the mandatory-audit rule (AGENTS.md / .kilo/rules/
      // audit-mandatory-reason.md) intact for employee-initiated direct edits
      // without letting users forge audit rows for other people's records.
      allow create: if (
                    // Admin/manager path: reason optional (may be empty or omitted)
                    ((hasRole('admin') || hasRole('manager')) &&
                      request.resource.data.targetCollection is string &&
                      request.resource.data.occurredAt != null)
                    ||
                    // Employee self-edit path: reason mandatory
                    (isAuthenticated() &&
                      request.resource.data.actorRole == 'employee' &&
                      request.resource.data.actorUid == request.auth.uid &&
                      request.resource.data.action == 'time_correction' &&
                      request.resource.data.targetCollection == 'timeEntries' &&
                      request.resource.data.targetId is string &&
                      request.resource.data.targetId.matches(request.auth.uid + '_.*') &&
                      request.resource.data.reason is string &&
                      request.resource.data.reason.size() > 0 &&
                      request.resource.data.occurredAt != null
                    )
                  );
      
      // IMMUTABLE: no updates or deletes for any role
      allow update, delete: if false;
    }
  }
}

